<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="start_monitoring"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_start"
        android:shortcutShortLabel="@string/shortcut_start_monitoring"
        android:shortcutLongLabel="@string/shortcut_start_monitoring">
        <intent
            android:action="com.offlinenotifier.app.ACTION_START_MONITORING"
            android:targetPackage="com.offlinenotifier.app"
            android:targetClass="com.offlinenotifier.app.ShortcutActionActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="stop_monitoring"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_stop"
        android:shortcutShortLabel="@string/shortcut_stop_monitoring"
        android:shortcutLongLabel="@string/shortcut_stop_monitoring">
        <intent
            android:action="com.offlinenotifier.app.ACTION_STOP_MONITORING"
            android:targetPackage="com.offlinenotifier.app"
            android:targetClass="com.offlinenotifier.app.ShortcutActionActivity" />
    </shortcut>

</shortcuts>
